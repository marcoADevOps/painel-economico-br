# Copie para .env (fora do Git) e preencha. Nunca commite o .env.
# As senhas entram em URLs de conexão: use só caracteres seguros, por exemplo
# gerando com `openssl rand -hex 16`.

# --- Postgres (metadados do Airflow) ---
POSTGRES_USER=airflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=airflow

# --- Postgres (data warehouse: raw, staging, marts) ---
WAREHOUSE_DB=painel
WAREHOUSE_USER=painel
WAREHOUSE_PASSWORD=change-me

# --- Airflow ---
# Gerar com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
# Gerar com: openssl rand -hex 32
AIRFLOW_JWT_SECRET=
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me
# URL da interface, usada nos links dos alertas (ex.: http://<IP_DA_VM>:8080)
AIRFLOW_BASE_URL=

# --- Alertas no Telegram (vazio = alertas desligados) ---
# Token do @BotFather e ID do chat que recebe os alertas
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Metabase ---
# Senha do usuário "metabase" (banco interno do Metabase) e do "metabase_ro"
# (somente leitura no schema marts, usado pelos dashboards)
METABASE_DB_PASSWORD=change-me
METABASE_READER_PASSWORD=change-me

# --- Deploy ---
# Preenchido pelo workflow de deploy (imagem no GHCR). Sem ele, o compose usa
# a imagem local painel-airflow:local.
# AIRFLOW_IMAGE=
