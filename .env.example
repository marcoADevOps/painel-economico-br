# Copie para .env (fora do Git) e preencha. Nunca commite o .env.
# As senhas entram em URLs de conexão: use só caracteres seguros, por exemplo
# gerando com `openssl rand -hex 16`.

# --- Postgres (metadados do Airflow) ---
POSTGRES_USER=airflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=airflow

# --- Postgres (data warehouse: raw, staging, marts) ---
WAREHOUSE_DB=painel
WAREHOUSE_USER=painel
WAREHOUSE_PASSWORD=change-me

# --- Airflow ---
# Gerar com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
# Gerar com: openssl rand -hex 32
AIRFLOW_JWT_SECRET=
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me
